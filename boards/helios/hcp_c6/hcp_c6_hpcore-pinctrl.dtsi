/*
 * HCP ESP32-C6 pin control (hpcore). Console UART (uart0) + Modbus UART (uart1).
 * uart1 default = TTL pins (RS485 variant overlay switches pins + DE later).
 * SPDX-License-Identifier: Apache-2.0
 */

#include <zephyr/dt-bindings/pinctrl/esp-pinctrl-common.h>
#include <zephyr/dt-bindings/pinctrl/esp32c6-pinctrl.h>
#include <zephyr/dt-bindings/pinctrl/esp32c6-gpio-sigmap.h>

&pinctrl {
	uart0_default: uart0_default {
		group1 {
			pinmux = <UART0_TX_GPIO16>;
			output-high;
		};
		group2 {
			pinmux = <UART0_RX_GPIO17>;
			bias-pull-up;
		};
	};

	uart1_default: uart1_default {
		group1 {
			pinmux = <UART1_TX_GPIO22>;
			output-high;
		};
		group2 {
			pinmux = <UART1_RX_GPIO23>;
			bias-pull-up;
		};
	};

	/* No SPI2 group: the WS2812 is driven by RMT on its data line alone
	 * (../common/hcp_ws2812.dtsi), so there is nothing here to configure.
	 *
	 * The pin that gives back matters on this part: the SPI route had spent GPIO6 on
	 * a clock the WS2812 protocol never reads, and GPIO6 is the button on the C6
	 * (HCP_BTN_GPIO in hcp_c6_hpcore.dts). That is the whole argument against the SPI
	 * route in one collision - the C3's version was a clock landing on GPIO11, the
	 * chip's own RX, with two boards dark before it moved to GPIO7. Pins this board
	 * really uses, so the claim is checkable rather than assumed: console 16/17,
	 * modbus 22/23 (TTL) or 18/20 + DE 19 (RS485 variant), relays 0/3, button 6,
	 * LED 8. */
};
