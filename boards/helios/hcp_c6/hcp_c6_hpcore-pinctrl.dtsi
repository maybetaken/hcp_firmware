/*
 * HCP ESP32-C6 pin control (hpcore). Console UART (uart0) + Modbus UART (uart1).
 * uart1 default = TTL pins (RS485 variant overlay switches pins + DE later).
 * SPDX-License-Identifier: Apache-2.0
 */

#include <zephyr/dt-bindings/pinctrl/esp-pinctrl-common.h>
#include <zephyr/dt-bindings/pinctrl/esp32c6-pinctrl.h>
#include <zephyr/dt-bindings/pinctrl/esp32c6-gpio-sigmap.h>

&pinctrl {
	uart0_default: uart0_default {
		group1 {
			pinmux = <UART0_TX_GPIO16>;
			output-high;
		};
		group2 {
			pinmux = <UART0_RX_GPIO17>;
			bias-pull-up;
		};
	};

	uart1_default: uart1_default {
		group1 {
			pinmux = <UART1_TX_GPIO22>;
			output-high;
		};
		group2 {
			pinmux = <UART1_RX_GPIO23>;
			bias-pull-up;
		};
	};

	/* No SPI2 group: the strip is on RMT (../common/hcp_ws2812.dtsi), so GPIO6 - the clock
	 * pad that route reserved - is unclaimed again. It was not colliding with anything
	 * in this build; the collision actually demonstrated is the C3's, where the clock
	 * first sat on GPIO11, the chip's own RX. Pins in use: console 16/17, modbus 22/23
	 * (TTL) or 18/20 + DE 19 (RS485), relays 0/3, button 9, LED 8. */
};
