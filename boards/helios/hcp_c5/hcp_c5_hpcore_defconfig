CONFIG_CONSOLE=y
CONFIG_SERIAL=y
CONFIG_UART_CONSOLE=y
CONFIG_GPIO=y
# The WROOM module carries 8 MB and the partition table spans it (storage/prodinfo sit
# above 0x7b0000). Zephyr's default tells esptool 2 MB, so `erase-flash` erased only the
# lowest quarter. Match the tool to the part.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
