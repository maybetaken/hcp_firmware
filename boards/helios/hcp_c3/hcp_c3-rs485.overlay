/*
 * ESP32-C3 RS485 variant overlay (mutually exclusive with the default TTL).
 * Applied via: build.sh hcp_c3 --rs485
 * Re-pins UART1 to the c3-485 physical pads (TX=GPIO4, RX=GPIO6) and adds the
 * DE/RE direction line for the external TTL->RS485 transceiver (DE=GPIO5),
 * exported as alias `hcp-rs485-dir` so the serial backend toggles it.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/esp32c3-pinctrl.h>
#include <zephyr/dt-bindings/pinctrl/esp32c3-gpio-sigmap.h>

/ {
	aliases {
		hcp-rs485-dir = &rs485_dir;
	};

	rs485 {
		compatible = "gpio-leds";
		rs485_dir: rs485-dir {
			label = "RS485 DE/RE";
			gpios = <&gpio0 5 GPIO_ACTIVE_HIGH>;
		};
	};
};

&pinctrl {
	uart1_rs485_default: uart1_rs485_default {
		group1 {
			pinmux = <UART1_TX_GPIO4>;
			output-high;
		};
		group2 {
			pinmux = <UART1_RX_GPIO6>;
			bias-pull-up;
		};
	};
};

&uart1 {
	pinctrl-0 = <&uart1_rs485_default>;
};

/* Zephyr's Modbus subsys drives DE itself: idle low, asserted for the duration of
 * each transmission (see modbus_serial.c), which is what the transceiver wants.
 * Same pad as the hcp-rs485-dir alias above, which hcp::serial still uses for the
 * raw loopback self-test - the two are not active in the same build. */
&modbus0 {
	de-gpios = <&gpio0 5 GPIO_ACTIVE_HIGH>;
};
