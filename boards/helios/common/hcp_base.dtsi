/*
 * HCP shared board skeleton (all Helios custom boards).
 *
 * The including board .dts MUST, before this file:
 *   - include its Espressif module dtsi, the partitions dtsi, and its
 *     `<board>-pinctrl.dtsi` (which defines uart0_default + uart1_default),
 *   - define the macros HCP_SRAM (label: sramhp|sram1) and HCP_BTN_GPIO
 *     (the button's GPIO number).
 *
 * Copyright (c) 2026 maybetaken
 *
 * SPDX-License-Identifier: Apache-2.0
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/* Console node. The RISC-V parts (C3/C5/C6) have a native USB-Serial-JTAG CDC; the
 * classic dual-core ESP32 does not, so it defines HCP_CONSOLE as a UART and
 * HCP_NO_USB_SERIAL to skip the usb_serial node entirely. */
#ifndef HCP_CONSOLE
#define HCP_CONSOLE usb_serial
#endif

/ {
	chosen {
		zephyr,sram = &HCP_SRAM;
		zephyr,console = &HCP_CONSOLE;
		zephyr,shell-uart = &HCP_CONSOLE;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		/* Persistent KV (hcp::storage -> settings -> NVS) uses the 192 KB
		 * "storage" slot of Espressif's default partition table, so provisioned
		 * Wi-Fi credentials survive a power cycle without a new partition per board. */
		zephyr,storage = &storage_partition;
	};

	aliases {
		sw0 = &hcp_button;
		hcp-uart = &uart1;
		hcp-k1 = &relay_k1;
		hcp-k2 = &relay_k2;
		/* Watchdog the trial-image deadline is set on (hcp::kernel) and the one
		 * MCUboot's watchdog code looks for by the same name. The alias is here so
		 * both sides agree; the node itself is only enabled on the boards that boot
		 * through MCUboot - where it stays "disabled", ArmWatchdog() has nothing to
		 * arm and the update path behaves as it did before. */
		watchdog0 = &wdt0;
	};

	gpio_keys {
		compatible = "gpio-keys";
		hcp_button: button_0 {
			label = "HCP User SW";
			gpios = <&gpio0 HCP_BTN_GPIO (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	/* Relay outputs K1/K2 (same pins across chips, active-low per the original
	 * firmware). Held as gpio-leds so the gpios property parses; hcp::switchctl
	 * drives them via gpio_dt_spec (logical 1 = assert = physical low). */
	relays {
		compatible = "gpio-leds";
		relay_k1: relay_0 {
			label = "HCP Relay K1";
			gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;
		};
		relay_k2: relay_1 {
			label = "HCP Relay K2";
			gpios = <&gpio0 3 GPIO_ACTIVE_LOW>;
		};
	};
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

/* Modbus UART (UART1). Default TTL pins; RS485 variant overlay re-pins + DE. */
&uart1 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart1_default>;
	pinctrl-names = "default";

	/* hcp::modbus rides Zephyr's own Modbus RTU client (subsys/modbus) on this
	 * UART. The subsys owns the RTU framing, the t3.5 inter-frame timing and -
	 * through de-gpios, set by the RS485 variant overlay - the direction line of
	 * the external transceiver. The client looks the interface up by this node's
	 * name, so renaming it means updating hcp::modbus to match. */
	modbus0: modbus0 {
		compatible = "zephyr,modbus-serial";
		status = "okay";
	};
};

&gpio0 {
	status = "okay";
};

/* Wi-Fi is physically present on all Espressif Helios boards; the node is
 * always enabled here, and the networking stack / driver is pulled in only
 * when CONFIG_HCP_NET (see lib/net) selects CONFIG_WIFI. */
&wifi {
	status = "okay";
};

/* ESP32 Bluetooth controller (HCI) — needed for BLE/BluFi. Disabled by default
 * in the SoC dtsi; the stock devkitc enables it the same way. */
&esp32_bt_hci {
	status = "okay";
};

/* Console via native USB-Serial-JTAG (CDC-ACM) -> /dev/cu.usbmodem* on host.
 * Absent on the classic ESP32, which defines HCP_NO_USB_SERIAL. */
#ifndef HCP_NO_USB_SERIAL
&usb_serial {
	status = "okay";
};
#endif
