/*
 * HCP shared WS2812 binding: one data line, waveforms from RMT.
 *
 * All three Helios boards have the strip's data line on GPIO8 - what each board's old
 * SPI-MOSI group named, and what the previous firmware drove (_led(GPIO_NUM_8, 1)).
 *
 * Not the worldsemi,ws2812-spi route they used to use: that needs a SPI controller plus
 * a clock pin the protocol never reads, and the extra pin is a pin spent. On the C3 it
 * went to GPIO11 - the chip's own RX - and two boards were dark before it moved to GPIO7;
 * the C5 and C6 each kept a pad (GPIO9, GPIO6) reserved for a signal nobody reads. RMT
 * needs the one wire the strip actually has. See CHANGELOG.md 2.0.3.19.
 *
 * The alias is what the application looks up, so nothing above the devicetree knows
 * which peripheral produces the waveform.
 *
 * SPDX-License-Identifier: Apache-2.0
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/led/led.h>

/ {
	aliases {
		hcp-led-strip = &led_strip;
	};

	led_strip: led-strip {
		compatible = "espressif,esp32-ws2812-rmt";
		status = "okay";

		/* Also the pin the previous firmware drove with RMT. */
		data-gpios = <&gpio0 8 GPIO_ACTIVE_HIGH>;
		chain-length = <1>;

		/* RMT TX channel 0: nothing else on these boards uses RMT. */
		espressif,rmt-channel = <0>;

		/* The board states how its LED is wired; the driver obeys. */
		color-mapping = <LED_COLOR_ID_GREEN
				 LED_COLOR_ID_RED
				 LED_COLOR_ID_BLUE>;
	};
};
