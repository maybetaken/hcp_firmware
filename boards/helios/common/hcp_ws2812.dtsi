/*
 * HCP shared WS2812 binding - one data line, waveforms generated by RMT.
 *
 * Every Helios board has the strip's data line on GPIO8: that is what each board's
 * SPI-MOSI group used to name, and what the previous firmware drove
 * (_led(GPIO_NUM_8, 1)), so the three agree rather than this file assuming it.
 *
 * Deliberately not the worldsemi,ws2812-spi route all three used to use: that needs a
 * SPI controller plus a clock pin the WS2812 protocol has no use for, and the extra pin
 * is not free in practice. On the C3 the clock landed on GPIO11, which is the chip's own
 * RX, and two boards were dark before it moved to GPIO7; on the C6 it sat on GPIO6,
 * which is that board's button (HCP_BTN_GPIO). Binding RMT to the one wire the strip
 * actually has removes both the spare pin and the collisions it can cause. Zephyr ships
 * no led_strip driver for Espressif RMT, hence the module.
 *
 * The alias is what the application looks up, so nothing above the devicetree knows
 * which peripheral produces the waveform.
 *
 * SPDX-License-Identifier: Apache-2.0
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/led/led.h>

/ {
	aliases {
		hcp-led-strip = &led_strip;
	};

	led_strip: led-strip {
		compatible = "espressif,esp32-ws2812-rmt";
		status = "okay";

		/* The pin the old firmware drove with RMT too. */
		data-gpios = <&gpio0 8 GPIO_ACTIVE_HIGH>;
		chain-length = <1>;

		/* RMT TX channel 0: nothing else on these boards uses RMT. */
		espressif,rmt-channel = <0>;

		/* The board states how its LED is wired; the driver obeys rather than
		 * assuming an order. */
		color-mapping = <LED_COLOR_ID_GREEN
				 LED_COLOR_ID_RED
				 LED_COLOR_ID_BLUE>;
	};
};
