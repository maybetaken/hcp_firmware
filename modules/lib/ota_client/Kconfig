# ota_client module Kconfig
#
# Copyright (c) 2026 the ota_client authors
# SPDX-License-Identifier: MIT

menuconfig OTA_CLIENT
	bool "Firmware update client (transport agnostic)"
	help
	  Applies an update policy over two small operation tables: a source of
	  image bytes (HTTP today, anything else can be added by the user) and a
	  sink that stages them for the bootloader (MCUboot today). The core has no
	  dependency on a board, an application or a cloud service.

if OTA_CLIENT

config OTA_CLIENT_ALLOW_DOWNGRADE
	bool "Accept any version difference, including downgrades"
	default n
	help
	  By default an image is only fetched when its version is strictly newer
	  than the running one. Enable this to also accept an older image, which is
	  useful for factory re-flows but turns "check" into "always download".

config OTA_CLIENT_VERSION_MAX_LEN
	int "Maximum length of a version string"
	default 32

config OTA_CLIENT_URL_MAX_LEN
	int "Maximum length of an URL"
	default 128

config OTA_CLIENT_SOURCE_HTTP
	bool "HTTP(S) image source"
	default y
	select HTTP_CLIENT
	help
	  Streams an image from a plain HTTP server. No TLS: authenticity and
	  integrity are the bootloader's job (MCUboot validates the image
	  signature), and transport encryption is a deployment decision. The
	  source can be replaced by the application without touching the core.

if OTA_CLIENT_SOURCE_HTTP

config OTA_CLIENT_HTTP_RECV_BUF_SIZE
	int "HTTP receive buffer size"
	default 2048
	help
	  Size of the buffer the HTTP client parses into; body fragments are handed
	  to the sink straight out of it, so this is the per-chunk memory cost.

config OTA_CLIENT_HTTP_TIMEOUT_MS
	int "Timeout for the version probe (ms)"
	default 10000
	help
	  Budget for one whole HTTP exchange, as Zephyr's http_client_req() treats it
	  that way. The version file is a few bytes, so a stall here means the server
	  is not answering and the update should fail fast.

config OTA_CLIENT_HTTP_IMAGE_TIMEOUT_MS
	int "Timeout for the image download (ms)"
	default 300000
	help
	  Same kind of budget, for the image itself: a megabyte over a busy 2.4 GHz
	  link legitimately takes tens of seconds. Measured on an ESP32-C6 at ~100
	  kB/s, so 1 MB needs roughly 10 s of transfer plus flash writes; the default
	  leaves room for a much slower or noisier network.

endif # OTA_CLIENT_SOURCE_HTTP

config OTA_CLIENT_SINK_MCUBOOT
	bool "MCUboot image sink"
	default y
	# Select, do not depend: an application should get a working update path by
	# turning one knob. flash_img.c is built by IMG_MANAGER (MCUBOOT_IMG_MANAGER is
	# that menu's default choice, and it needs FLASH_MAP), while the activation and
	# confirmation calls come from bootutil via BOOTLOADER_MCUBOOT.
	select FLASH_MAP
	select STREAM_FLASH
	select IMG_MANAGER
	select BOOTLOADER_MCUBOOT
	help
	  Writes the incoming image into the secondary slot through Zephyr's
	  flash_img helper and asks MCUboot to swap it on the next reset. Also
	  provides the confirmation used to keep the new image once the device is
	  known healthy.

config OTA_CLIENT_THREAD
	bool "Provide a library worker thread"
	default n
	help
	  Runs ota_client_start()'s update on a dedicated thread, so a caller that
	  cannot block (a sensor or network thread) is not stuck for the length of
	  a download. Without this, call ota_client_update() from your own thread
	  or work queue and ota_client_start() returns -ENOSYS.

if OTA_CLIENT_THREAD

config OTA_CLIENT_THREAD_STACK_SIZE
	int "Worker thread stack size"
	default 4096

config OTA_CLIENT_THREAD_PRIORITY
	int "Worker thread priority (preemptive)"
	default 10

endif # OTA_CLIENT_THREAD

module = OTA_CLIENT
module-str = ota_client
source "subsys/logging/Kconfig.template.log_config"

endif # OTA_CLIENT
