# WS2812-over-RMT driver for ESP32 parts (Zephyr module)
# SPDX-License-Identifier: Apache-2.0

config LED_STRIP_ESP_RMT
	bool "WS2812 LED strip over the ESP32 RMT peripheral"
	depends on DT_HAS_ESPRESSIF_ESP32_WS2812_RMT_ENABLED
	select LED_STRIP
	default y
	help
	  Drives WS2812-class addressable LEDs through an RMT TX channel, behind
	  Zephyr's standard led_strip API. Enabled by having a node with compatible
	  "espressif,esp32-ws2812-rmt" in the devicetree; no board has to name a
	  Kconfig symbol to get it.

	  This exists because Zephyr ships no led_strip driver for Espressif RMT, and
	  because CPU bit-banging cannot hold the WS2812 phase widths on these parts:
	  measured on an ESP32-C3, a GPIO store costs 312 ns and a system-clock read
	  687 ns against a 400 ns phase, so the loop's own instrumentation is coarser
	  than what it has to control. RMT generates the waveforms from a hardware
	  counter and needs no interrupt blackout across a frame.
