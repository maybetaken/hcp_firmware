menuconfig HCP_PROVISION
	bool "HCP provisioning state machine (credentials, LED, button)"
	default y
	depends on BLUFI && HCP_NET && HCP_STORAGE && HCP_INPUT
	help
	  Owns the boot policy around connectivity: try the credentials saved in
	  hcp::storage, fall back to BluFi when they do not work, persist what the
	  phone provisions, close BLE after success, show the state on the status LED
	  and act on the user button (short press = reboot, long press = forget
	  credentials). The transition logic (lib/provision/src/fsm.cpp) is pure and
	  covered by the host tests.

if HCP_PROVISION

config HCP_PROVISION_LED_BRIGHTNESS
	int "status LED brightness (percent)"
	range 1 100
	default 10
	help
	  Global scale applied to the status palette by hcp::led::Strip::SetBrightness().
	  The palette itself is authored at full 8-bit scale, so this single knob dims
	  every state. The LED sits on for half of each blink cycle, so 10 is already
	  clearly visible in a normal room; raise it for a panel-mounted enclosure.

config HCP_PROVISION_BAKEIN_SSID
	string "network to join when storage holds no credentials (bench / factory)"
	default ""
	help
	  Pre-provisioning. With both these empty - the default, and what ships - a device
	  with nothing in storage waits for a phone over BluFi. Set them and the first
	  boot instead joins this network and writes the pair into storage, so from then
	  on it behaves like any provisioned device (the phone, the button and Home
	  Assistant can all still replace it).

	  The passphrase is compiled into the image: anyone with the binary has the
	  network key. It is therefore only ever meant to come from an untracked conf
	  fragment - build.sh folds wificreds.conf (gitignored) into the build - and the
	  build directory carries _wifi so such an image cannot be mistaken for the
	  shipping one.

config HCP_PROVISION_BAKEIN_PSK
	string "passphrase for that network (empty = open network)"
	default ""

endif
