# hcp::provision module Kconfig
# SPDX-License-Identifier: Apache-2.0

menuconfig HCP_PROVISION
	bool "HCP provisioning state machine (credentials, LED, button)"
	default y
	depends on BLUFI && HCP_NET && HCP_STORAGE && HCP_INPUT
	help
	  Owns the boot policy around connectivity: try the credentials saved in
	  hcp::storage, fall back to BluFi when they do not work, persist what the
	  phone provisions, close BLE after success, show the state on the status LED
	  and act on the user button (short press = reboot, long press = forget
	  credentials). The transition logic (lib/provision/src/fsm.cpp) is pure and
	  covered by the host tests.

if HCP_PROVISION

config HCP_PROVISION_LED_BRIGHTNESS
	int "status LED brightness (percent)"
	range 1 100
	default 10
	help
	  Global scale applied to the status palette by hcp::led::Strip::SetBrightness().
	  The palette itself is authored at full 8-bit scale, so this single knob dims
	  every state. The LED sits on for half of each blink cycle, so 10 is already
	  clearly visible in a normal room; raise it for a panel-mounted enclosure.

endif
