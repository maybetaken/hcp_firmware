# hcp::led module Kconfig
# SPDX-License-Identifier: Apache-2.0

menuconfig HCP_LED
	bool "HCP LED strip (WS2812-class)"
	default y
	help
	  Addressable LED strip support. The WS2812 node is in the shared board
	  devicetree (boards/helios/common/hcp_ws2812.dtsi) because the LED is present
	  on all Helios boards; this option decides only whether the application drives
	  it, and the backend below decides through what. To drop the driver from the
	  binary as well, disable what it selects (LED_STRIP, LED_STRIP_ESP_RMT).

if HCP_LED

choice HCP_LED_BACKEND
	prompt "LED backend"
	default HCP_LED_BACKEND_ZEPHYR

config HCP_LED_BACKEND_ZEPHYR
	bool "Zephyr led_strip API on the hcp-led-strip alias"
	select LED_STRIP
	help
	  The strip is whatever the board's devicetree binds to the hcp-led-strip alias -
	  the espressif,esp32-ws2812-rmt driver (modules/drivers/ws2812_rmt) on all three
	  Helios boards. No bus dependency comes from here: a driver's own Kconfig brings
	  its bus, and a board should not link a controller it cannot use.

config HCP_LED_BACKEND_POSIX
	bool "POSIX framebuffer (host tests)"

endchoice

endif
