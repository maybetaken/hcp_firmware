# hcp::led module Kconfig
# SPDX-License-Identifier: Apache-2.0

menuconfig HCP_LED
	bool "HCP LED strip (WS2812-class)"
	default y
	help
	  Addressable LED strip support. The WS2812 node is described in the shared
	  board devicetree (boards/helios/common/hcp_ws2812.dtsi) since the LED is
	  physically present on all Helios boards; this option only decides whether the
	  application drives it, and the backend choice below decides through what. To
	  also drop a driver from the binary, disable the CONFIG it selects
	  (LED_STRIP, and LED_STRIP_ESP_RMT or WS2812_STRIP_SPI for the driver itself).

if HCP_LED

choice HCP_LED_BACKEND
	prompt "LED backend"
	default HCP_LED_BACKEND_ZEPHYR

config HCP_LED_BACKEND_ZEPHYR
	bool "Zephyr led_strip API on the hcp-led-strip alias"
	select LED_STRIP
	help
	  The strip is whatever the board's devicetree binds to that alias - today the
	  espressif,esp32-ws2812-rmt driver (modules/drivers/ws2812_rmt) on all three
	  Helios boards. Selecting this adds no SPI dependency of its own, because a
	  driver's Kconfig brings its own bus: a board bound to RMT must not link an SPI
	  controller it does not use.

config HCP_LED_BACKEND_POSIX
	bool "POSIX framebuffer (host tests)"

endchoice

endif
