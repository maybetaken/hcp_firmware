# hcp::mqtt module Kconfig
# SPDX-License-Identifier: Apache-2.0

menuconfig HCP_MQTT
	bool "HCP MQTT service session"
	# The client-id and every topic prefix come from the device serial number.
	depends on HCP_NET && HCP_IDENTITY
	# MQTT runs over TCP. The rest of HCP needs no TCP at all (Modbus is serial,
	# DNS/mDNS are UDP), so the stack is not enabled anywhere else - without this
	# select, zsock_connect simply fails and every connection attempt errors out.
	select NET_TCP
	# imply, not select: MQTT_LIB selects NET_SOCKETS, so a select/imply from a
	# symbol that itself depends on NET_SOCKETS would be a dependency loop. This
	# way MQTT_LIB pulls NET_SOCKETS in for us.
	imply MQTT_LIB
	default y
	help
	  Keeps one MQTT connection alive on top of the Wi-Fi station link and reports
	  the session to hcp::provision, so the status LED can tell "Wi-Fi up but the
	  broker is not" (violet) from "everything up" (green). Built on Zephyr's own
	  socket MQTT library - no extra third-party dependency.

if HCP_MQTT

config HCP_MQTT_HOST
	string "default broker host (empty = wait for it to be learned at runtime)"
	default ""
	help
	  Dotted IPv4 or a hostname. The discovery layer (SSDP) overrides this at
	  runtime through hcp::mqtt::SetBroker() and it is then kept in storage, so
	  leave this empty unless the broker address is fixed.

config HCP_MQTT_PORT
	int "default broker port"
	default 1883

config HCP_MQTT_USER
	string "broker username (empty = connect without credentials)"
	help
	  Compiled in on purpose: the account is created by the user on their own
	  broker, so it is not provisioned over the air.

config HCP_MQTT_PASS
	string "broker password"

config HCP_MQTT_TOPIC_DIAGNOSTICS
	string "diagnostics topic suffix (published as <sn>/<this>)"
	default "diagnostics"
	help
	  The topic Home Assistant's solar_manager integration subscribes for its
	  diagnostics sensors (base_device.handle_diagnostics). It used to be "state",
	  a name this firmware invented: nothing on the other side listened to it, so the
	  heartbeat was published into the void while the 120 s clear timer on the
	  integration kept running down. Payload keys the integration reads are ssid,
	  rssi and led; unknown keys are ignored, so uptime/firmware/ota travel safely
	  alongside them.

config HCP_MQTT_TOPIC_CMD
	string "command topic suffix (subscribed as <sn>/<this>)"
	default "cmd"

config HCP_MQTT_MAX_ROUTES
	int "Number of topic suffixes a handler may be registered for"
	default 10
	help
	  The client subscribes to "<sn>/#" and "<sn>-K/#" and dispatches locally, so
	  this is how many handlers the application can register (Home Assistant uses one
	  per function: config, the modbus write channel, the relay channel, restart,
	  heartbeat, ...). A registration beyond this fails loudly at boot rather than
	  silently ignoring the topic.

	  The count is not free to guess: nine are in use - seven for the meter device
	  (config, control/cmd, control/restart, control/reconfig, control/led,
	  host/heartbeat, ota/start), one for <sn>/cmd and one for <sn>-K/control/cmd -
	  so two are headroom. The ESP32-C5 used to default this to 1 while its collector
	  was disabled, which was not a saving: it made the collector refuse to start.
	  One entry is 36 bytes (a 24-byte suffix, the callback, its user pointer and the
	  topic tree it belongs to).

config HCP_MQTT_MAX_INBOUND
	int "Largest inbound payload kept (bytes)"
	default 448 if BOARD_HCP_C5
	default 512
	help
	  Larger than the outbound limit on purpose: a config download carries a whole
	  JSON point table and the widest one in use (jkbms.json) is about 390 bytes.
	  Anything above this is consumed and discarded, so a too-small value shows up
	  as a warning in the log instead of a desynchronised stream.

config HCP_MQTT_TOPIC_ONLINE
	string "online topic suffix (published once per connect)"
	default "online"

config HCP_MQTT_FW_VERSION
	string "firmware version reported on the online topic"
	default APP_VERSION
	help
	  Defaults to the build's single version knob (CONFIG_APP_VERSION) so the
	  broker, the OTA check and the image header can never disagree; overriding
	  this separately would be a footgun.

config HCP_MQTT_KEEPALIVE_SEC
	int "keepalive interval (seconds)"
	default 30

config HCP_MQTT_DIAG_INTERVAL_SEC
	int "periodic diagnostics publish interval (seconds, 0 = event-driven only)"
	default 30
	help
	  Publishes the small JSON status document on <sn>/diagnostics while the session
	  is up. Two reasons it must stay well under 120: Home Assistant clears the
	  diagnostics and device data after 120 s without an update (CLEAR_INTERVAL in
	  plugins/base_device.py), and without a periodic message the device is silent on
	  the broker between events - which leaves the MQTT debug view empty and gives no
	  liveness signal.

config HCP_MQTT_CONNECT_TIMEOUT_MS
	int "how long to wait for CONNACK"
	default 10000

config HCP_MQTT_RETRY_BASE_MS
	int "first reconnect backoff step (ms)"
	default 1000

config HCP_MQTT_RETRY_CAP_MS
	int "reconnect backoff ceiling (ms)"
	default 30000

config HCP_MQTT_BUF_SIZE
	int "MQTT rx/tx buffer size (bytes)"
	default 512

config HCP_MQTT_STACK_SIZE
	int "session thread stack size"
	default 4096

endif
