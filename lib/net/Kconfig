# hcp::net module Kconfig
# SPDX-License-Identifier: Apache-2.0

menuconfig HCP_NET
	bool "HCP networking (Wi-Fi station)"
	default y
	select NETWORKING
	select NET_IPV4
	select NET_DHCPV4
	select NET_L2_ETHERNET
	select NET_MGMT
	select NET_MGMT_EVENT
	select NET_MGMT_EVENT_INFO
	select NET_L2_WIFI_MGMT
	select WIFI
	select DNS_RESOLVER
	# esp32 Wi-Fi runtime essentials (else association/DHCP are flaky)
	select ESP32_WIFI_STA_AUTO_DHCPV4
	help
	  Wi-Fi station support. Enabled by default: networking is core to the
	  collector. Pulls the Zephyr net stack + esp_wifi driver (the board's
	  &wifi node is already status=okay). Heap/stack sizing lives in prj.conf.

if HCP_NET

config HCP_NET_DEMO
	bool "Bring-up: connect to the SSID below on boot and log status"
	default n

choice HCP_NET_SECURITY
	prompt "Wi-Fi security (bring-up demo)"
	default HCP_NET_SECURITY_AUTO

config HCP_NET_SECURITY_AUTO
	bool "WPA/WPA2/WPA3 auto-negotiate"

config HCP_NET_SECURITY_PSK
	bool "WPA2-PSK only"

config HCP_NET_SECURITY_SAE
	bool "WPA3-SAE only"

endchoice

config HCP_NET_SSID
	string "Bring-up Wi-Fi SSID (for the demo connect)"
	default ""

config HCP_NET_PSK
	string "Bring-up Wi-Fi PSK (empty = open)"
	default ""

endif
