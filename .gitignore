# Build outputs (created by ./build.sh inside the container, persisted to host)
build/
build_*/

# Mbed TLS tree fetched by modules/lib/blufi/tools/fetch_mbedtls.sh - upstream
# sources for the optional encrypted provisioning, never a copy in this repo.
modules/lib/.mbedtls-2.28/

# Local / secret config — never commit (e.g. real Wi-Fi credentials)
*.local.conf
wificreds.conf

# MCUboot signing keys: whoever holds root-ec256.pem can produce firmware every
# flashed bootloader accepts. Generate your own with tools/make_signing_key.sh and
# read tools/mcuboot/SIGNING.md before losing or sharing one; the public half is
# derived at build time.
keys/

# Editor / OS cruft
.vscode/
*.swp
.DS_Store
