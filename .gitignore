# Build outputs (created by ./build.sh inside the container, persisted to host)
build/
build_*/

# Local / secret config — never commit (e.g. real Wi-Fi credentials)
*.local.conf
wificreds.conf

# MCUboot signing keys: whoever holds root-ec256.pem can produce firmware every
# flashed bootloader accepts. Generate your own with tools/make_signing_key.sh
# (see tools/mcuboot/README.md); the public half is derived at build time.
keys/

# Editor / OS cruft
.vscode/
*.swp
.DS_Store
